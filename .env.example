NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=backend/data/zimconnect.sqlite
TRUST_PROXY_HOPS=0

# Payment processing is deliberately sandbox-only; no real funds are moved.
PAYMENT_MODE=sandbox

# S3-compatible private bucket for identity documents and videos.
AWS_REGION=af-south-1
S3_BUCKET=
S3_ENDPOINT=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# SMTP email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Africa's Talking SMS verification.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Google Maps Routes API. Keep the key server-side and restrict it by API/IP.
GOOGLE_MAPS_API_KEY=

# AI support. The route redacts common PII patterns and does not store prompts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local encrypted database backups. Generate a random 32-byte key and keep it
# outside the backup directory; losing it makes the backups unrecoverable.
BACKUP_DIRECTORY=backend/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# Confirm applicable legal requirements before enabling production retention.
IDENTITY_RETENTION_DAYS=30
GPS_RETENTION_DAYS=7
VIDEO_RETENTION_DAYS=30
