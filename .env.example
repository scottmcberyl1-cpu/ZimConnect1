NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=backend/data/zimconnect.sqlite
DATABASE_URL=
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://127.0.0.1:3000

# Set true only after a Paynow merchant integration is approved and configured.
PAYNOW_ENABLED=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# S3-compatible private storage and off-site encrypted backup destination.
AWS_REGION=af-south-1
S3_BUCKET=
S3_ENDPOINT=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
IDENTITY_UPLOADS_ENABLED=false
IDENTITY_POLICY_URL=
IDENTITY_POLICY_VERSION=
VIDEO_UPLOADS_ENABLED=false
BACKUP_S3_BUCKET=

# SMTP email verification.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Africa's Talking SMS verification.
SMS_ENABLED=false
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Google Maps Routes API. Keep the key server-side and restrict it by API/IP.
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# AI support. The route redacts common PII patterns and does not store prompts.
AI_SUPPORT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Encrypted database backups. Local mode uses a random 32-byte key; production uses AWS KMS.
BACKUP_DIRECTORY=backend/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_KMS_KEY_ID=
BACKUP_RETENTION_DAYS=30

# Confirm applicable legal requirements before enabling production retention.
IDENTITY_RETENTION_DAYS=30
GPS_RETENTION_DAYS=7
VIDEO_RETENTION_DAYS=30
